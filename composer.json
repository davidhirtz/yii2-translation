{
  "name": "davidhirtz/yii2-translation",
  "description": "Exports message translations to an Excel file and imports them back",
  "license": "proprietary",
  "type": "yii2-extension",
  "homepage": "https://www.github.com/davidhirtz/yii2-translation",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-skeleton": "^3.8",
    "phpoffice/phpspreadsheet": "^5.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Hirtz\\Translation\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hirtz\\Translation\\Tests\\": "tests"
    }
  },
  "extra": {
    "bootstrap": "Hirtz\\Translation\\Bootstrap",
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "phpstan": "phpstan --memory-limit=2G",
    "test": "phpunit"
  }
}
